APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# آدرسی که مرورگر به بک‌اند می‌زنه (روی سرور: https://example.com/piano/Api). لینک عکس پروفایل و ایمیل‌ها از همین ساخته می‌شن
APP_URL=http://localhost:9000
# origin فرانت (بدون مسیر و اسلش آخر)
FRONTEND_URL=http://localhost:8087
CORS_ALLOWED_ORIGINS=http://localhost:8087

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=piano
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# اسم کوکی نشست؛ نباید «piano-session» باشه (فرانت با همین اسم کوکی نشانه می‌ذاره)
SESSION_COOKIE=piano_api_session
# روی سرور https: true
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8087

# پشت پراکسی (Nginx/Cloudflare) برای گرفتن IP واقعی کاربر: * ؛ خالی = هیچ
TRUSTED_PROXIES=

# پیامک: log یا kavenegar
SMS_DRIVER=log
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=verify

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ایمیل (تأیید عضویت باشگاه): log فقط توی لاگ می‌نویسه؛ برای ارسال واقعی smtp
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
