# مقادیر لازم برای .env پروژه‌ی لاراول (بقیه‌ی کلیدها همون پیش‌فرض‌های لاراول بمونن)

APP_URL=http://localhost:8000

# --- دیتابیس ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=piano
DB_USERNAME=root
DB_PASSWORD=

# --- فرانت (Nuxt) ---
# دقیقاً همین origin که توی مرورگر باز می‌کنی؛ localhost با 127.0.0.1 فرق داره!
FRONTEND_URL=http://localhost:8087
CORS_ALLOWED_ORIGINS=http://localhost:8087
SANCTUM_STATEFUL_DOMAINS=localhost:8087

# --- نشست ---
SESSION_DRIVER=database
# اسمش باید با کوکی «piano-session» فرانت فرق داشته باشه، وگرنه همدیگه رو خراب می‌کنن
SESSION_COOKIE=piano_api_session
# ۳۰ روز (دقیقه)؛ هم‌اندازه‌ی عمر کوکی نشانه‌ی ورود توی فرانت
SESSION_LIFETIME=43200
# روی لوکال خالی بمونه (کوکی فقط برای خود localhost). موقع انتشار روی دامنه‌ی واقعی تنظیم می‌شه.
SESSION_DOMAIN=null
