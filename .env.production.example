# قالب .env سرور دمو (روی سرور با اسم .env ذخیره کن؛ هیچ‌وقت توی آرشیو/گیت نذارش)
# فرانت: https://saleh.sinatech-dm.com/piano/   بک‌اند: https://saleh.sinatech-dm.com/piano/api

APP_NAME=Piano
APP_ENV=production
# با دستور php artisan key:generate ساخته می‌شه (کلید لوکال رو استفاده نکن)
APP_KEY=
APP_DEBUG=false
APP_URL=https://saleh.sinatech-dm.com/piano/api
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# اطلاعات دیتابیس سرور (نه همون root لوکال)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# فرانت و بک‌اند روی یک دامنه‌ان (same-origin)، پس CORS عملاً درگیر نیست؛ ولی Sanctum باید دامنه رو «stateful» بشناسه
FRONTEND_URL=https://saleh.sinatech-dm.com
CORS_ALLOWED_ORIGINS=https://saleh.sinatech-dm.com
SANCTUM_STATEFUL_DOMAINS=saleh.sinatech-dm.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# اسم و مسیر جدا تا با اپ‌های دیگه‌ی همین دامنه قاطی نشه (کوکی XSRF-TOKEN هم از همین مسیر پیروی می‌کنه)
SESSION_COOKIE=piano_session
SESSION_PATH=/piano
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# تا پنل پیامک نداری: log (کد توی storage/logs/laravel.log نوشته می‌شه). بعداً: kavenegar
SMS_DRIVER=log
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=verify
